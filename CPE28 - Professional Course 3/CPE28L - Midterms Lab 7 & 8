n(pca_df):\n","    print(f\"Index 300 (PC0, PC1, PC2): {pca_df.loc[300, ['PC0', 'PC1', 'PC2']].values}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"dTRA_aa2plY7","executionInfo":{"status":"ok","timestamp":1759809541612,"user_tz":-480,"elapsed":15,"user":{"displayName":"PADUADA DAVE JHARED G","userId":"06445372606359223617"}},"outputId":"a4843758-5350-4f43-bd5a-3386aaff065e"},"execution_count":128,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Index 285 (PC0, PC1): [ 2.74564132 -0.65410149]\n","Index 300 (PC0, PC1, PC2): [-1.60160797 -0.82633159 -1.14543204]\n"]}]},{"cell_type":"code","source":["# 8. KMeans Clustering (Optimal K)\n","\n","inertias = []\n","K_range = range(1, 11)\n","for k in K_range:\n","    km = KMeans(n_clusters=k, random_state=101)\n","    km.fit(pca_df[['PC0', 'PC1']])\n","    inertias.append(km.inertia_)\n","\n","plt.figure(figsize=(6, 4))\n","plt.plot(K_range, inertias, marker='o')\n","plt.title(\"Elbow Method (KMeans Clustering)\")\n","plt.xlabel(\"Number of Clusters (K)\")\n","plt.ylabel(\"Inertia\")\n","plt.grid(True)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":410},"id":"XBKYgOKZ0p00","executionInfo":{"status":"ok","timestamp":1759809551290,"user_tz":-480,"elapsed":334,"user":{"displayName":"PADUADA DAVE JHARED G","userId":"06445372606359223617"}},"outputId":"ae42a89f-035e-4a73-ef6e-d937ee127d1a"},"execution_count":129,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# 9–11. DBSCAN Clustering\n","\n","eps_values = np.arange(0.5, 3.0, 0.1)\n","outliers = []\n","\n","for eps in eps_values:\n","    db = DBSCAN(eps=eps, min_samples=5)\n","    labels = db.fit_predict(pca_df[['PC0', 'PC1']])\n","    n_outliers = np.sum(labels == -1)\n","    outliers.append(n_outliers)\n","\n","plt.figure(figsize=(7, 4))\n","plt.plot(eps_values, outliers, marker='o')\