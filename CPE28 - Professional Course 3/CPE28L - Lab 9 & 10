{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyODyNSlvt5LtbFtNtBezSH+"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Lab 9 & 10"],"metadata":{"id":"-KGuNBGfoVRI"}},{"cell_type":"code","source":[],"metadata":{"id":"LUDwmj87yA3R","executionInfo":{"status":"ok","timestamp":1761018420410,"user_tz":-480,"elapsed":20,"user":{"displayName":"PADUADA DAVE JHARED G","userId":"06445372606359223617"}}},"execution_count":49,"outputs":[]},{"cell_type":"code","source":["# Cell 1: Setup - Imports and Constants\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import scipy.cluster.hierarchy as shc\n","from matplotlib.patches import Ellipse\n","import matplotlib.transforms as transforms\n","from sklearn.preprocessing import MinMaxScaler\n","from sklearn.decomposition import PCA\n","from sklearn.cluster import KMeans, AgglomerativeClustering, DBSCAN\n","from sklearn.mixture import GaussianMixture\n","from sklearn.metrics import silhouette_score\n","import warnings\n","\n","# Suppress warnings for cleaner output\n","warnings.filterwarnings('ignore')\n","\n","# --- Constants from Instructions ---\n","RANDOM_STATE = 42\n","PCA_N_COMPONENTS = 2\n","HC_LINKAGE = 'ward'\n","\n","# --- File URLs ---\n","file_urls = {\n","    'cluster-01.csv': 'https://raw.githubusercontent.com/renatomaaliw3/public_files/refs/heads/master/Data%20Sets/cluster-01.csv',\n","    'cluster-02.csv': 'https://raw.githubusercontent.com/renatomaaliw3/public_files/refs/heads/master/Data%20Sets/cluster-02.csv',\n","    'cluster-03.csv': 'https://raw.githubusercontent.com/renatomaaliw3/public_files/refs/heads/master/Data%20Sets/cluster-03.csv',\n","    'cluster-04.csv': 'https://raw.githubusercontent.com/renatomaaliw3/public_files/refs/heads/master/Data%20Sets/cluster-04.csv',\n","    'cluster-05.csv': 'https://raw.githubusercontent.com/renatomaaliw3/public_files/refs/heads/master/Data%20Sets/cluster-05.csv'\n","}\n"],"metadata":{"id":"oqlVYk7SyOCH","executionInfo":{"status":"ok","timestamp":1761018420415,"user_tz":-480,"elapsed":2,"user":{"displayName":"PADUADA DAVE JHARED G","userId":"06445372606359223617"}}},"execution_count":50,"outputs":[]},{"cell_type":"code","source":["#  Helper Functions (with GMM Plotting)\n","\n","def preprocess_data(df, random_state_val, n_components_val):\n","    \"\"\"\n","    Applies MinMaxScaler and PCA as per instructions.\n","    \"\"\"\n","    df_cleaned = df.dropna()\n","    scaler = MinMaxScaler()\n","    scaled_features = scaler.fit_transform(df_cleaned)\n","    pca = PCA(n_components=n_components_val, random_state=random_state_val)\n","    pca_data = pca.fit_transform(scaled_features)\n","    return pca_data, df_cleaned.index\n","\n","def plot_clusters(data, labels, title, ax):\n","    \"\"\"\n","    Generates a 2D scatter plot on a given matplotlib axis.\n","    \"\"\"\n","    unique_labels = sorted(set(labels))\n","    n_clusters = len(unique_labels) - (1 if -1 in unique_labels else 0)\n","\n","    if n_clusters == 0:\n","        colors = []\n","    else:\n","        colors = plt.cm.Spectral(np.linspace(0, 1, n_clusters))\n","\n","    for k in unique_labels:\n","        if k == -1:\n","            col, label, markersize = [0, 0, 0, 1], 'Noise', 4\n","        else:\n","            col, label, markersize = colors[k], f'Cluster {k}', 8\n","\n","        class_member_mask = (labels == k)\n","        xy = data[class_member_mask]\n","        ax.plot(xy[:, 0], xy[:, 1], 'o', markerfacecolor=tuple(col),\n","                markeredgecolor='k', markersize=markersize, label=label,\n","                alpha=0.7)\n","\n","    ax.set_title(title)\n","    ax.set_xlabel(\"PCA Component 1\")\n","    ax.set_ylabel(\"PCA Component 2\")\n","    ax.legend()\n","    ax.grid(True, linestyle='--', alpha=0.5)\n","\n","def plot_gmm_ellipses(gmm, ax):\n","    \"\"\"\n","    Plots the elliptical contours for a fitted GMM model on a given axis.\n","    \"\"\"\n","    n_components = gmm.n_components\n","    colors = plt.cm.Spectral(np.linspace(0, 1, n_components))\n","\n","    for i in range(n_components):\n","        covariances = gmm.covariances_[i][:2, :2]\n","        v, w = np.linalg.eigh(covariances)\n","        v = 2. * np.sqrt(2.) * np.sqrt(v) # 2 std deviations\n","        u = w[0] / np.linalg.norm(w[0])\n","        angle = np.degrees(np.arctan2(u[1], u[0]))\n","\n","        ell = Ellipse(gmm.means_[i, :2], v[0], v[1], 180. + angle,\n","                      facecolor=colors[i], edgecolor='black',\n","                      linestyle='-', linewidth=2,\n","                      alpha=0.2)\n","        ax.add_patch(ell)\n","\n","\n","def plot_dendrogram(data, title):\n","    \"\"\"\n","    Generates a dendrogram for hierarchical clustering.\n","    \"\"\"\n","    print(f\"\\n--- Dendrogram for {title} ---\")\n","    plt.figure(figsize=(12, 6))\n","    plt.title(f\"Dendrogram (Linkage: '{HC_LINKAGE}') for {title}\")\n","    linkage_matrix = shc.linkage(data, method=HC_LINKAGE)\n","    shc.dendrogram(linkage_matrix)\n","    plt.xlabel(\"Data Points (or cluster index)\")\n","    plt.ylabel(\"Distance (Ward)\")\n","    plt.show()\n","\n","def find_best_model(data, random_state_val):\n","    \"\"\"\n","    Tests KMeans, Hierarchical Clustering (HC), and GMM for k=2 to 7.\n","    Returns the name, k, score, labels, and the model object itself.\n","    \"\"\"\n","    cluster_range = range(2, 8)\n","    best_score = -1\n","    best_model_name = \"\"\n","    best_k = 0\n","    best_labels = None\n","    best_model_object = None\n","\n","    for k in cluster_range:\n","        # 1. KMeans\n","        kmeans = KMeans(n_clusters=k, random_state=random_state_val, n_init=10)\n","        labels_kmeans = kmeans.fit_predict(data)\n","        score_kmeans = silhouette_score(data, labels_kmeans, random_state=random_state_val)\n","\n","        if score_kmeans > best_score:\n","            best_score, best_model_name, best_k, best_labels, best_model_object = \\\n","                score_kmeans, 'KMeans', k, labels_kmeans, kmeans\n","\n","        # 2. Hierarchical Clustering (HC)\n","        hc = AgglomerativeClustering(n_clusters=k, linkage=HC_LINKAGE)\n","        labels_hc = hc.fit_predict(data)\n","        score_hc = silhouette_score(data, labels_hc, random_state=random_state_val)\n","\n","        if score_hc > best_score:\n","            best_score, best_model_name, best_k, best_labels, best_model_object = \\\n","                score_hc, 'Hierarchical', k, labels_hc, hc\n","\n","        # 3. Gaussian Mixture Model (GMM)\n","        gmm = GaussianMixture(n_components=k, random_state=random_state_val)\n","        labels_gmm = gmm.fit_predict(data)\n","        score_gmm = silhouette_score(data, labels_gmm, random_state=random_state_val)\n","\n","        if score_gmm > best_score:\n","            best_score, best_model_name, best_k, best_labels, best_model_object = \\\n","                score_gmm, 'GMM', k, labels_gmm, gmm\n","\n","    return best_model_name, best_k, best_score, best_labels, best_model_object\n","\n","def find_best_dbscan(data, min_samples_val):\n","    \"\"\"\n","    Tests DBSCAN with a range of epsilon values.\n","    Returns the best epsilon, its score, outlier count, and labels.\n","    \"\"\"\n","    eps_range = np.arange(0.01, 1.0, 0.01)\n","    best_score = -1\n","    best_eps = 0\n","    best_labels = None\n","\n","    for eps in eps_range:\n","        dbscan = DBSCAN(eps=eps, min_samples=min_samples_val)\n","        labels = dbscan.fit_predict(data)\n","        unique_labels = set(labels)\n","        n_clusters = len(unique_labels) - (1 if -1 in unique_labels else 0)\n","\n","        if n_clusters >= 2:\n","            score = silhouette_score(data, labels, random_state=RANDOM_STATE)\n","            if score > best_score:\n","                best_score = score\n","                best_eps = eps\n","                best_labels = labels\n","\n","    if best_labels is None:\n","        best_labels = np.full(len(data), -1) # All are outliers\n","        return 0, -1, len(data), best_labels\n","\n","    outlier_count = np.sum(best_labels == -1)\n","    return best_eps, best_score, outlier_count, best_labels\n"],"metadata":{"id":"TTSpMYFHyOfn","executionInfo":{"status":"ok","timestamp":1761018420445,"user_tz":-480,"elapsed":5,"user":{"displayName":"PADUADA DAVE JHARED G","userId":"06445372606359223617"}}},"execution_count":51,"outputs":[]},{"cell_type":"code","source":["#  --- PART 1: Q1 & Q2 (cluster-01.csv) ---\n","\n","print(\"=\"*30)\n","print(\"PART 1: Q1 & Q2 (cluster-01.csv)\")\n","print(\"=\"*30)\n","\n","try:\n","    df1 = pd.read_csv(file_urls['cluster-01.csv'])\n","    print(\"cluster-01.csv loaded successfully.\")\n","\n","    data1, _ = preprocess_data(df1, RANDOM_STATE, PCA_N_COMPONENTS)\n","    print(f\"Data preprocessed: {data1.shape[0]} samples, {data1.shape[1]} PCA components\")\n","\n","    # Find Best Model (now returns the model object)\n","    model_name_1, k_1, score_1, labels_1, model_1 = find_best_model(data1, RANDOM_STATE)\n","\n","    print(\"\\n--- RESULTS (Q1 & Q2) ---\")\n","    print(f\"Q1: Best clustering model: {model_name_1}\")\n","    print(f\"Q2: Best number of clusters (k): {k_1}\")\n","    print(f\"    (Based on best silhouette score: {score_1:.4f})\")\n","\n","    print(\"\\n--- VISUALIZATIONS (cluster-01.csv) ---\")\n","\n","    # 1. Plot the best model's clusters\n","    fig, ax = plt.subplots(figsize=(10, 6))\n","    plot_title_1 = f\"Best Model: {model_name_1} (k={k_1})\\nSilhouette Score: {score_1:.4f}\"\n","    plot_clusters(data1, labels_1, plot_title_1, ax)\n","\n","    if model_name_1 == 'GMM':\n","        print(\"Plotting GMM ellipses...\")\n","        plot_gmm_ellipses(model_1, ax)\n","\n","    plt.show()\n","\n","    # 2. Plot the Dendrogram\n","    plot_dendrogram(data1, \"cluster-01.csv PCA Data\")\n","\n","except Exce